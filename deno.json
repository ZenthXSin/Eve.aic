{
  "unstable": [
    "worker-options"
  ],
  "tasks": {
    "test": "deno test --reporter=tap --no-check --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1,127.0.0.2 tests/",
    "test:qq": "deno test --allow-net=127.0.0.1,127.0.0.2 tests/qq_client_test.ts",
    "check": "deno check deployment/ runtime/ supervisor/ services/ guardian/ kernel/ sdk/ contracts/ plugins/ adapters/ composition/ demo/ tests/*.ts",
    "demo": "deno run --allow-read --allow-write --allow-run --allow-env demo/run.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "include": [
      "kernel/",
      "sdk/",
      "contracts/",
      "plugins/",
      "prompts/",
      "adapters/",
      "composition/",
      "tests/",
      "demo/",
      "guardian/",
      "services/",
      "runtime/",
      "supervisor/",
      "deployment/"
    ]
  },
  "lint": {
    "exclude": [
      "tests/fixtures/counter-v2-typeerror/",
      "adapters/qq/satori/"
    ]
  },
  "exclude": [
    "data/"
  ],
  "imports": {
    "tiktoken": "npm:tiktoken@1.0.22"
  }
}
