{
  "rules": [
    {
      "pattern": [["shutdown", "reboot", "poweroff", "halt"]],
      "decision": "forbidden",
      "justification": "会让 Eve 所在的机器停机或重启；需要时请主人自己操作",
      "match": [["shutdown", "-h", "now"], "reboot"],
      "not_match": ["shutdownd"]
    },
    {
      "pattern": [["mkfs", "mkfs.ext4", "mkfs.xfs", "mkfs.vfat", "wipefs"]],
      "decision": "forbidden",
      "justification": "会格式化或改写磁盘分区，无法恢复",
      "match": [["mkfs.ext4", "/dev/sdb1"]]
    },
    {
      "pattern": ["rm", ["-rf", "-fr", "-r", "-R", "--recursive"], ["/", "/*", "~", "~/", "$HOME", "/home", "/root", "/etc", "/usr", "/var"]],
      "decision": "forbidden",
      "justification": "递归删除系统或家目录；只删除工作区里明确的文件或目录",
      "match": ["rm -rf /", "rm -r ~", ["rm", "-fr", "/etc"]],
      "not_match": ["rm -rf build", "rm -rf ./target"]
    },
    {
      "pattern": ["chmod", ["-R", "--recursive"], ["777", "a+rwx", "o+w"]],
      "decision": "prompt",
      "justification": "递归放开所有人的读写权限",
      "match": ["chmod -R 777 data"],
      "not_match": ["chmod -R 755 data"]
    },
    {
      "pattern": ["kill", "-9", ["1", "-1"]],
      "decision": "forbidden",
      "justification": "会结束系统初始进程或全部进程",
      "match": ["kill -9 1", "kill -9 -1"],
      "not_match": ["kill -9 4321"]
    },
    {
      "pattern": ["systemctl", ["stop", "disable", "mask", "kill"]],
      "decision": "prompt",
      "justification": "会停止或禁用系统服务，可能包括 Eve 自己",
      "match": ["systemctl stop eve", "systemctl disable nginx"],
      "not_match": ["systemctl status eve"]
    }
  ]
}
